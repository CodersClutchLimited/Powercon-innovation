<%- layout('layouts/boiler') %>
  <style>
    .iconhover:hover {
      background: rgb(5, 5, 92);
    }
  </style>


  <!-- Hero Section with Video Background -->
  <main class="relative text-white min-h-screen">
    <video autoplay loop muted class="absolute inset-0 w-full h-full object-cover">
      <source src="https://videos.pexels.com/video-files/8853462/8853462-sd_640_360_24fps.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>

    <div class="relative flex flex-col items-center justify-center min-h-screen bg-black bg-opacity-50">
      <div class="px-6 text-center" id="scroll-content">
        <h1 class="rob1 text-4xl sm:text-3xl md:text-5xl lg:text-17xl font-bold uppercase">
          specialized services
        </h1>
        <p class="para1 mt-5 text-2xl font-semibold z-50">
          Offering a comprehensive range of specialized services tailored to your needs
        </p>
      </div>
    </div>
  </main>

  <div class="model mx-auto">
    <p class="paragraph text-center leading-relaxed text-xl font-medium">
      From custom engineering solutions to unique infrastructure projects, our specialized services are designed to meet
      the specific demands of any project. We focus on delivering innovative, high-quality solutions that address the
      most complex challenges. For years, Powercon Innovation has been trusted to provide expert services that drive
      success across various industries and sectors.
    </p>
  </div>


  <div class="p-4 w-full mt-0 mb-4">
    <div class="flex space-x-1 mt-3 h-2">
      <div class="flex-1 bg-teal transform skew-x-12"></div>
      <div class="flex-1 bg-dark-blue transform skew-x-12"></div>
      <div class="flex-1 bg-lime-green transform skew-x-12"></div>
    </div>
  </div>


  <div class="max-w-screen-xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-extrabold text-center mb-10">
      SPECIALIZED SERVICE AREAS
    </h1>

    <!-- Cards Container -->
    <div class="divs grid grid-cols-1 md:grid-cols-3 gap-6 rounded-xl">
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img
          src="/img/mining.jpg"
          class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">MINING</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We provide comprehensive mining solutions, focusing on efficient operations, safety, and sustainable
            resource extraction.
          </p>
        </div>
        <a href="/services/specialized/mining-services"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


      <!-- Card 1: Bridge Replacement -->
      <div class="bg-white rounded-lg shadow-lg relative">
        <img
          src="/img/industrial.jpg"
          class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">
            INDUSTRIAL ENGINEERING
          </h2>
          <p class="text-gray-600 mb-5 pb-6">
            We offer industrial engineering solutions to optimize processes, increase productivity, and enhance
            operational efficiency.
          </p>
        </div>
        <a href="/services/specialized/industrial-eng"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


      <!-- Card 2: Construction Engineering Inspections -->


      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img
          src="/img/electrical.jpg"
          class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">RESIDENTIAL ELECTRICALS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We provide expert residential electrical services, ensuring safe, reliable, and efficient electrical systems
            for homes.
          </p>
        </div>
        <a href="/services/specialized/residential-electrical"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img
          src="/img/procure.jpg"
          class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">PROCUREMENT</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We offer efficient procurement services, ensuring high-quality materials and equipment are sourced
            cost-effectively and delivered on time.
          </p>
        </div>
        <a href="/services/specialized/procurement"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

    </div>
  </div>
  <!-- Include Swiper CSS -->
  <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

  <div class="text-center py-16 mt-12">
    <h2 class="text-2xl font-bold mb-2 relative inline-block">
      OUR TAILORED SERVICES
      <span class="custom-underline c"></span>
    </h2>
    <div class="swiper-container mt-12 mx-5 sm:mx-8">
      <div class="swiper-wrapper">
        <!-- Transportation -->
        <div class="swiper-slide">
          <a href="/services/transportation" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/route.png" alt="Transportation Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">TRANSPORTATION</p>
          </a>
        </div>
        <!-- Water Resources -->
        <div class="swiper-slide">
          <a href="/services/water-resources" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/water.png" alt="Water Resources Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">WATER RESOURCES</p>
          </a>
        </div>
        <!-- Power & Engineering -->
        <div class="swiper-slide">
          <a href="/services/power-eng" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/power.png" alt="Power & Engineering Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">POWER & ENGINEERING</p>
          </a>
        </div>
        <!-- Residential Construction -->
        <div class="swiper-slide">
          <a href="/services/residential-const" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/real-estate.png" alt="Residential Construction Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">RESIDENTIAL CONSTRUCTION</p>
          </a>
        </div>
        <!-- Industrial Construction -->
        <div class="swiper-slide">
          <a href="/services/industrial-const" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/industrial-park.png" alt="Industrial Construction Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">INDUSTRIAL CONSTRUCTION</p>
          </a>
        </div>
        <!-- Specialized Services -->
        <div class="swiper-slide">
          <a href="/services/specialized" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/privilege.png" alt="Specialized Services Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">SPECIALIZED SERVICES</p>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Include Swiper JS -->
  <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

  <!-- Initialize Swiper -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var swiper = new Swiper('.swiper-container', {
        slidesPerView: 1,
        spaceBetween: 5,
        loop: true,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        breakpoints: {
          640: {
            slidesPerView: 2,
            spaceBetween: 20,
          },
          768: {
            slidesPerView: 3,
            spaceBetween: 30,
          },
          1024: {
            slidesPerView: 4,
            spaceBetween: 40,
          },
        },
      });
    });
  </script>