<%- layout('layouts/boiler') %>

  <style>
    .iconhover:hover {
      background: rgb(5, 5, 92);
    }
  </style>

  <!-- Hero Section with Video Background -->
  <main class="relative text-white min-h-screen">

    <img src="/img/mining.jpg" class="absolute inset-0 w-full h-full object-cover" alt="">
    <div class="relative flex flex-col items-center justify-center min-h-screen bg-black bg-opacity-50">
      <div class="px-6 text-center" id="scroll-content">
        <h1 class="rob1 text-2xl sm:text-3xl md:text-5xl lg:text-10xl font-bold uppercase">
          Mining
        </h1>

        <p class="para1 mt-5 text-2xl font-semibold z-50">
          Delivering a comprehensive range of advanced mining systems and solutions
        </p>
      </div>
    </div>
  </main>

  <div class="model mx-auto">
    <p class="paragraph text-center leading-relaxed text-xl font-medium">
      Mining is the cornerstone of industrial progress and economic growth. From developing advanced extraction
      techniques and safety protocols to implementing sustainable practices and efficient resource management, we
      approach mining with innovation and responsibility. For years, Powercon Innovation has partnered with various
      sectors to build reliable and future-ready mining infrastructure.
    </p>
  </div>


  <div class="p-4 w-full mt-0 mb-4">
    <div class="flex space-x-1 mt-3 h-2">
      <div class="flex-1 bg-teal transform skew-x-12"></div>
      <div class="flex-1 bg-dark-blue transform skew-x-12"></div>
      <div class="flex-1 bg-lime-green transform skew-x-12"></div>
    </div>
  </div>

  <div class="max-w-screen-xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-extrabold text-center mb-10">
      MINING SERVICE AREAS
    </h1>
    <!-- Cards Container -->
    <div class="divs grid grid-cols-1 md:grid-cols-3 gap-6 rounded-xl">
      <!-- Card 1: Bridge Replacement -->
      <div class="bg-white rounded-lg shadow-lg relative">
        <img src="/img/reha.jpg" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">
            CLOSURE REHABILITATION
          </h2>
          <p class="text-gray-600 mb-5 pb-6">
            Our expertise in close rehabilitation ensures the safe and efficient closure of mining sites, adhering to
            the highest environmental and safety standards.
          </p>
        </div>
        <a href="/services/mining/closure-rehab.."
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


      <!-- Card 2: Construction Engineering Inspections -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/sup.jpg" alt="Bridge Replacement Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">EQUIPMENT SUPPLY</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We specialize in supplying high-quality mining equipment, ensuring our clients have access to the latest and
            most efficient tools for their operations.
          </p>
        </div>
        <a href="/services/mining/supply"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/log.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">LOGISTIC AND TRANSPORTATION</h2>
          <p class="text-gray-600 mb-5 pb-6">
            Our logistics and transportation services are designed to optimize the movement of mining materials and
            equipment, ensuring timely and efficient delivery to support mining operations.
          </p>
        </div>
        <a href="/services/mining/logistic-transportation"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/mined.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">MINE DEVELOPMENT</h2>
          <p class="text-gray-600 mb-5 pb-6">
            Our expertise includes comprehensive mine development services, from initial exploration and feasibility
            studies to full-scale mine construction and operation, ensuring efficient and sustainable mining practices.
          </p>
        </div>
        <a href="/services/mining/mine-dev"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/minep.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">MINING PROCESS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            Our mining process services encompass the entire lifecycle of mining operations, from exploration and
            extraction to processing and reclamation, ensuring efficiency, safety, and sustainability at every stage.
          </p>
        </div>
        <a href="/services/mining/min-process"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/mineo.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">MINING OPERATIONS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            Our mining operations services cover all aspects of mining activities, including planning, extraction,
            processing, and site management, ensuring optimal productivity, safety, and environmental stewardship.
          </p>
        </div>
        <a href="/services/mining/mining-operations"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/minec.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">MINING CONSULTATION</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We offer expert mining consultation services, providing strategic guidance and innovative solutions to
            optimize mining operations, enhance safety, and ensure regulatory compliance.
          </p>
        </div>
        <a href="/services/mining/mining-consult.."
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>



    </div>
  </div>



  <!-- Include Swiper CSS -->
  <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

  <div class="text-center py-16 mt-12">
    <h2 class="text-2xl font-bold mb-2 relative inline-block">
      OUR TAILORED SERVICES
      <span class="custom-underline c"></span>
    </h2>
    <div class="swiper-container mt-12 mx-5 sm:mx-8">
      <div class="swiper-wrapper">
        <!-- Transportation -->
        <div class="swiper-slide">
          <a href="/services/transportation" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/route.png" alt="Transportation Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">TRANSPORTATION</p>
          </a>
        </div>
        <!-- Water Resources -->
        <div class="swiper-slide">
          <a href="/services/water-resources" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/water.png" alt="Water Resources Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">WATER RESOURCES</p>
          </a>
        </div>
        <!-- Power & Engineering -->
        <div class="swiper-slide">
          <a href="/services/power-eng" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/power.png" alt="Power & Engineering Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">POWER & ENGINEERING</p>
          </a>
        </div>
        <!-- Residential Construction -->
        <div class="swiper-slide">
          <a href="/services/residential-const" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/real-estate.png" alt="Residential Construction Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">RESIDENTIAL CONSTRUCTION</p>
          </a>
        </div>
        <!-- Industrial Construction -->
        <div class="swiper-slide">
          <a href="/services/industrial-const" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/industrial-park.png" alt="Industrial Construction Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">INDUSTRIAL CONSTRUCTION</p>
          </a>
        </div>
        <!-- Specialized Services -->
        <div class="swiper-slide">
          <a href="/services/specialized" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/privilege.png" alt="Specialized Services Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">SPECIALIZED SERVICES</p>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Include Swiper JS -->
  <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

  <!-- Initialize Swiper -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var swiper = new Swiper('.swiper-container', {
        slidesPerView: 1,
        spaceBetween: 5,
        loop: true,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        breakpoints: {
          640: {
            slidesPerView: 2,
            spaceBetween: 20,
          },
          768: {
            slidesPerView: 3,
            spaceBetween: 30,
          },
          1024: {
            slidesPerView: 4,
            spaceBetween: 40,
          },
        },
      });
    });
  </script>