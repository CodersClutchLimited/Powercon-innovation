<%- layout('layouts/boiler') %>

  <style>
    .iconhover:hover {
      background: rgb(5, 5, 92);
    }
  </style>

  <!-- Hero Section with Video Background -->
  <main class="relative text-white min-h-screen">
    <video autoplay loop muted class="absolute inset-0 w-full h-full object-cover">
      <source src="https://videos.pexels.com/video-files/29930476/12845471_2560_1440_60fps.mp4" type="video/mp4" />
      Your browser does not support the video tag.
    </video>

    <div class="relative flex flex-col items-center justify-center min-h-screen bg-black bg-opacity-50">
      <div class="px-6 text-center" id="scroll-content">
        <h1 class="rob1 text-2xl sm:text-3xl md:text-5xl lg:text-10xl font-bold uppercase">
          Transportation
        </h1>

        <p class="para1 mt-5 text-2xl font-semibold z-50">
          Delivering a comprehensive range of advanced transportation systems and solutions
        </p>
      </div>
    </div>
  </main>

  <div class="model mx-auto">
    <p class="paragraph text-center leading-relaxed text-xl font-medium">
      Transportation is the backbone of thriving communities and economic development. From crafting modern road
      networks and roundabouts to implementing smart systems and sustainable transit options, we approach mobility with
      innovation and efficiency. For years, Powercon Innovation has worked alongside municipalities, communities, and
      industries to build reliable and future-ready transportation infrastructure.
    </p>
  </div>


  <div class="p-4 w-full mt-0 mb-4">
    <div class="flex space-x-1 mt-3 h-2">
      <div class="flex-1 bg-teal transform skew-x-12"></div>
      <div class="flex-1 bg-dark-blue transform skew-x-12"></div>
      <div class="flex-1 bg-lime-green transform skew-x-12"></div>
    </div>
  </div>

  <div class="max-w-screen-xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-extrabold text-center mb-10">
      TRANSPORTATION SERVICE AREAS
    </h1>
    <!-- Cards Container -->
    <div class="divs grid grid-cols-1 md:grid-cols-3 gap-6 rounded-xl">
      <!-- Card 1: Bridge Replacement -->
      <div class="bg-white rounded-lg shadow-lg relative">
        <img src="/img/inspect1.jpg" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">
            INSPECTIONS AND MANAGEMENT
          </h2>
          <p class="text-gray-600 mb-5 pb-6">
            One of our key strengths is delivering top-notch inspection and management services for diverse projects
            across public and private sectors.
          </p>
        </div>
        <a href="/services/transport/inspect"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


      <!-- Card 2: Construction Engineering Inspections -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/bridge.jpg" alt="Bridge Replacement Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">BRIDGE CONSTRUCTION</h2>
          <p class="text-gray-600 mb-5 pb-6">
            A core strength lies in providing exceptional bridge construction services, catering to federal, state,
            local, and private clients.
          </p>
        </div>
        <a href="/services/transport/bridge"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/smart.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">SMART ROAD SYSTEMS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We excel in delivering innovative smart road systems tailored to enhance safety and efficiency for various
            clients.
          </p>
        </div>
        <a href="/services/transport/smart"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/asphalt.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">ASHPHALT-FREE AND HIGHWAY</h2>
          <p class="text-gray-600 mb-5 pb-6">
            Our expertise includes developing asphalt-free road solutions and advanced highway systems for sustainable
            infrastructure.
          </p>
        </div>
        <a href="/services/transport/asphalt"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/urban.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">URBAN RURAL STREETS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We specialize in creating urban complete streets that prioritize safety, accessibility, and sustainability
            for all users.
          </p>
        </div>
        <a href="/services/transport/urban-rural"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/pede.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">PEDESTERIAN AND CYCLE AMENITIES</h2>
          <p class="text-gray-600 mb-5">
            We focus on providing high-quality pedestrian and cycle amenities to enhance mobility and safety in urban
            environments.
          </p>
        </div>
        <a href="/services/transport/pedesterian"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/round.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">ROUNDABOUTS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We offer efficient roundabout designs that improve traffic flow and enhance safety for all road users.
          </p>
        </div>
        <a href="/services/transport/round"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


      <!-- Card 3: Freeways and Highways -->
      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/signal.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">SIGNALIZATION</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We provide advanced signalization solutions to optimize traffic management and improve road safety across
            various networks.
          </p>
        </div>
        <a href="/services/transport/signalization"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/rail.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">RAILWAYS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We focus on railway construction and infrastructure, offering cutting-edge solutions to enhance connectivity, safety, and efficiency within rail systems.
          </p>
        </div>
        <a href="/services/transport/railway"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>

      <div class="divs bg-white rounded-lg shadow-lg relative">
        <img src="/img/run.jpg" alt="Freeways and Highways Image" class="w-full h-56 object-cover rounded-lg" />
        <div class="p-6">
          <h2 class="font-bold text-lg mb-3">FLIGHT RUNWAYS</h2>
          <p class="text-gray-600 mb-5 pb-6">
            We provide advanced solutions to optimize runway management and improve safety across various airport
            networks. </p>
        </div>
        <a href="/services/transport/flight"
          class="absolute bottom-0 left-0 p-6 text-blue-600 font-semibold hover:underline">LEARN
          MORE</a>
      </div>


    </div>
  </div>



  <!-- Include Swiper CSS -->
  <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css" />

  <div class="text-center py-16 mt-12">
    <h2 class="text-2xl font-bold mb-2 relative inline-block">
      OUR TAILORED SERVICES
      <span class="custom-underline c"></span>
    </h2>
    <div class="swiper-container mt-12 mx-5 sm:mx-8">
      <div class="swiper-wrapper">
        <!-- Transportation -->
        <div class="swiper-slide">
          <a href="/services/transportation" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/route.png" alt="Transportation Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">TRANSPORTATION</p>
          </a>
        </div>
        <!-- Water Resources -->
        <div class="swiper-slide">
          <a href="/services/water-resources" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/water.png" alt="Water Resources Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">WATER RESOURCES</p>
          </a>
        </div>
        <!-- Power & Engineering -->
        <div class="swiper-slide">
          <a href="/services/power-eng" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/power.png" alt="Power & Engineering Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">POWER & ENGINEERING</p>
          </a>
        </div>
        <!-- Residential Construction -->
        <div class="swiper-slide">
          <a href="/services/residential-const" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/real-estate.png" alt="Residential Construction Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">RESIDENTIAL CONSTRUCTION</p>
          </a>
        </div>
        <!-- Industrial Construction -->
        <div class="swiper-slide">
          <a href="/services/industrial-const" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/industrial-park.png" alt="Industrial Construction Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">INDUSTRIAL CONSTRUCTION</p>
          </a>
        </div>
        <!-- Specialized Services -->
        <div class="swiper-slide">
          <a href="/services/specialized" class="flex flex-col items-center p-6 rounded-lg">
            <div class="bg-black iconhover w-32 h-32 rounded-full flex items-center justify-center">
              <img src="/icons/privilege.png" alt="Specialized Services Icon" class="h-16">
            </div>
            <p class="mt-4 text-base font-bold">SPECIALIZED SERVICES</p>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Include Swiper JS -->
  <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>

  <!-- Initialize Swiper -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var swiper = new Swiper('.swiper-container', {
        slidesPerView: 1,
        spaceBetween: 5,
        loop: true,
        autoplay: {
          delay: 3000,
          disableOnInteraction: false,
        },
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        breakpoints: {
          640: {
            slidesPerView: 2,
            spaceBetween: 20,
          },
          768: {
            slidesPerView: 3,
            spaceBetween: 30,
          },
          1024: {
            slidesPerView: 4,
            spaceBetween: 40,
          },
        },
      });
    });
  </script>